# NJ Transit Bus Data API credentials
# Register at https://developer.njtransit.com/registration/
VITE_NJT_USERNAME=your_username_here
VITE_NJT_PASSWORD=your_password_here

# MTA Bus API key
# Register at https://bt.mta.info/wiki/Developers/Index
MTA_BUS_API_KEY=your_api_key_here

# Optional: backend server port (defaults to 3001)
# BUS_API_PORT=3001

# Optional: restrict CORS to your deployed frontend URL (recommended in production)
# ALLOWED_ORIGIN=https://your-app.railway.app
